{
  "name": "lifelook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1421 --strictPort",
    "web:dev": "npm run dev",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "test": "vitest run",
    "test:engine": "vitest run --project engine",
    "test:browser": "vitest run --project browser",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "check": "npm run typecheck && npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "decimal.js": "10.6.0"
  },
  "overrides": {
    "vite": "$vite"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@types/node": "22.10.2",
    "jsdom": "25.0.1",
    "typescript": "5.7.3",
    "vite": "6.4.4",
    "vitest": "4.1.11"
  }
}
